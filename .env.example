# Supabase Postgres connection string — use the *Transaction pooler* string
# (Supabase dashboard → Connect → Transaction pooler, port 6543). The direct
# db.*.supabase.co host is IPv6-only, and the session pooler (5432) allows only
# 15 connections in total. Special characters in the password work as-is
# (or URL-encoded, e.g. "#" → %23).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# First admin account — created by `npm run db:setup` when no accounts exist.
# Afterwards manage accounts and passwords in Admin → Users.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Secret used to sign admin session cookies (32+ random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-at-least-32-random-characters

# Public URL of the site (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
