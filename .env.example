# Supabase Postgres connection string.
# Local dev can use the direct connection. On Vercel use the *Transaction pooler*
# string (Supabase dashboard → Connect → Transaction pooler, port 6543),
# because the direct db.*.supabase.co host is IPv6-only.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.poxzkxfulejmltqdrcvl.supabase.co:5432/postgres

# Admin login for /admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign admin session cookies (32+ random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public URL of the site (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
