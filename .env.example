# Supabase Postgres connection string — use the *Session pooler* string
# (Supabase dashboard → Connect → Session pooler, port 5432). The direct
# db.*.supabase.co host is IPv6-only, and the transaction pooler (6543) stalls
# when this app runs queries in parallel. URL-encode special characters in the
# password (e.g. "#" → %23).
DATABASE_URL=postgresql://postgres.poxzkxfulejmltqdrcvl:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# First admin account — created by `npm run db:setup` when no accounts exist.
# Afterwards manage accounts and passwords in Admin → Users.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign admin session cookies (32+ random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public URL of the site (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
